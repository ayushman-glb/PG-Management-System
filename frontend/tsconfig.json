{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@app/*": ["./src/app/*", "./src/*"],
      "@components/*": ["./src/components/*"],
      "@features/*": ["./src/features/*"],
      "@hooks/*": ["./src/hooks/*"],
      "@services/*": ["./src/services/*"],
      "@graphql/*": ["./src/graphql/*"],
      "@types/*": ["./src/types/*"],
      "@types": ["./src/types/index.ts"],
      "@config/*": ["./src/config/*"],
      "@utils/*": ["./src/utils/*"],
      "@constants/*": ["./src/constants/*"],
      "@theme/*": ["./src/theme/*"],
      "@theme": ["./src/theme/index.ts", "./src/theme"],
      "@pages/*": ["./src/pages/*"],
      "@store/*": ["./src/store/*"],
      "@providers/*": ["./src/providers/*"],
      "@schemas/*": ["./src/schemas/*"],
      "@guards/*": ["./src/guards/*"],
      "@guards": ["./src/guards/index.ts", "./src/guards"],
      "@assets/*": ["./src/assets/*"]
    },
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "vite.config.ts"]
}

# ============================================================
# RoomBae — Root .gitignore
# ============================================================

# ── Logs ────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Dependencies ─────────────────────────────────────────────
node_modules/
.pnpm-store/

# ── Build Outputs ─────────────────────────────────────────────
dist/
dist-ssr/
coverage/

# ── Environment / Secrets ─────────────────────────────────────
# Block ALL .env* files by default across the whole repo
.env
.env.local
.env.development
.env.production
.env.staging
.env.test
.env.*.local
**/.env
**/.env.local
**/.env.development
**/.env.production
**/.env.staging
**/.env.test
**/.env.*.local

# Allow ONLY the placeholder example templates
!.env.example
!**/.env.example

# Private keys, certificates, service accounts
*.pem
*.key
*.crt
*.p12
*.pfx
serviceAccountKey*.json
service-account*.json
firebase-admin*.json

# Credentials & Private Documentation
user_credentials.md
USER_CREDENTIALS.md
**/USER_CREDENTIALS.md
**/user_credentials.md
credentials*.md
*.credentials.md

# Uploads and temp files
uploads/
temp_uploads/
sample_pdfs/
*.zip
*.local

# ── TypeScript ─────────────────────────────────────────────────
tsconfig.tsbuildinfo

# ── Editor & OS files ──────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

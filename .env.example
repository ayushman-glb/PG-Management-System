# ==============================================================================
# RoomBae Enterprise SaaS — Master Environment Variables Template (.env.example)
# ==============================================================================
# Copy this file to .env, or configure backend/.env and frontend/.env individually.

# ── Server & Environment ──────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,https://pg-management-system.vercel.app,https://ayushman-glb.github.io
CROSS_ORIGIN_DEPLOYMENT=true
DEBUG_AUTH=false
API_BASE_URL=http://localhost:5000
API_PREFIX=/api/v1

# ── Database & Cache Infrastructure ───────────────────────────────────────────
# MongoDB Atlas Connection String with Replica Set support for Prisma ORM transactions
DATABASE_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/roombae?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/roombae?retryWrites=true&w=majority

REDIS_URL=redis://localhost:6379
CACHE_TTL=3600
SESSION_TTL=86400

# ── Cryptographic Secrets & Tokens ────────────────────────────────────────────
# Generate 32+ char random strings via `openssl rand -hex 32`
JWT_SECRET=dev_default_access_secret_key_32_chars_long!
JWT_REFRESH_SECRET=dev_default_refresh_secret_key_32_chars_long!
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

SESSION_SECRET=dev_default_session_secret_key_32_chars_long!
COOKIE_SECRET=dev_default_cookie_secret_key_32_chars_long!
CSRF_SECRET=dev_default_csrf_secret_key_32_chars_long!

PASSWORD_RESET_SECRET=dev_default_reset_secret_key_32_chars_long!
EMAIL_VERIFICATION_SECRET=dev_default_reset_secret_key_32_chars_long!
API_KEY_SECRET=dev_default_access_secret_key_32_chars_long!

# AES-256-GCM 64-character hex key for sensitive financial/KYC data encryption
AES_256_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
KYC_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ── Third-Party Integrations ─────────────────────────────────────────────────
# Geoapify Location Intelligence (Geocoding, Autocomplete & Places)
GEOAPIFY_API_KEY=your_geoapify_api_key_here

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Twilio Programmable SMS (Optional: fallback simulated OTP mode when omitted)
SMS_PROVIDER=TWILIO
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# Nodemailer / SMTP Email Relay
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your_email@gmail.com
MAIL_APP_PASSWORD=your_16_digit_app_password
MAIL_FROM_NAME=RoomBae
MAIL_FROM_EMAIL=your_email@gmail.com
EMAIL_FROM="RoomBae <your_email@gmail.com>"

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── Frontend Environment Variables (Vite Public) ─────────────────────────────
VITE_APP_NAME=RoomBae
VITE_APP_ENV=development
VITE_APP_VERSION=1.0.0
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_SOCKET_URL=http://localhost:5000
VITE_FRONTEND_URL=http://localhost:5173
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id

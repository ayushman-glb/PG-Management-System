# ==============================================================================
# RoomBae Enterprise SaaS — Environment Variables Template (.env.example)
# ==============================================================================
# Copy this file to .env or .env.development and populate values.

# ── Server & Environment ──────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:5000
API_PREFIX=/api/v1

# ── Database & Cache Infrastructure ───────────────────────────────────────────
# MongoDB Atlas Connection String with Replica Set support for Prisma ORM
DATABASE_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/roombae?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/roombae?retryWrites=true&w=majority

REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
CACHE_TTL=3600
SESSION_TTL=86400

# ── Cryptographic Secrets ──────────────────────────────────────────────────────
JWT_SECRET=dev_default_access_secret_key_32_chars_long!
JWT_REFRESH_SECRET=dev_default_refresh_secret_key_32_chars_long!
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

SESSION_SECRET=dev_default_session_secret_key_32_chars_long!
COOKIE_SECRET=dev_default_cookie_secret_key_32_chars_long!
CSRF_SECRET=dev_default_csrf_secret_key_32_chars_long!

PASSWORD_RESET_SECRET=dev_default_reset_secret_key_32_chars_long!
EMAIL_VERIFICATION_SECRET=dev_default_reset_secret_key_32_chars_long!
API_KEY_SECRET=dev_default_access_secret_key_32_chars_long!

AES_256_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
KYC_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ── Third-Party Integrations ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_smtp_user
SMTP_PASS=your_brevo_smtp_pass
EMAIL_FROM="RoomBae Enterprise <noreply@roombae.com>"

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

FIREBASE_PROJECT_ID=roombae-cff13
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@roombae.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_FIREBASE_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ==============================================================================
# RoomBae Enterprise SaaS — Production Environment Variables Template (.env.example)
# ==============================================================================
# IMPORTANT: Copy this file to '.env' or configure these environment variables in
# your cloud hosting dashboard (e.g. Render, AWS, Heroku).
# DO NOT commit actual secrets or production credentials to Git.
# ==============================================================================

# ── Server Core Configuration ──────────────────────────────────────────────────
PORT=5000
NODE_ENV=production
CLIENT_URL=https://ayushman-glb.github.io/PG-Management-System
FRONTEND_URL=https://ayushman-glb.github.io/PG-Management-System
API_BASE_URL=https://pg-management-system-boxb.onrender.com
API_PREFIX=/api/v1
REST_PREFIX=/api/v1
GRAPHQL_PATH=/graphql

# ── Database & In-Memory Cache ────────────────────────────────────────────────
# MongoDB Connection String (Atlas or Hosted)
DATABASE_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/roombae?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/roombae?retryWrites=true&w=majority
REDIS_URL=rediss://default:<redis_password>@<redis_host>:6379

# ── Authentication & Security Secrets (Generate using 32 random bytes: crypto.randomBytes(32).toString('hex'))
# 64 Hex Characters (256-bit entropy)
SESSION_SECRET=your_64_hex_char_session_secret_here
COOKIE_SECRET=your_64_hex_char_cookie_secret_here
CSRF_SECRET=your_64_hex_char_csrf_secret_here

JWT_SECRET=your_64_hex_char_jwt_access_secret_here
JWT_REFRESH_SECRET=your_64_hex_char_jwt_refresh_secret_here
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

PASSWORD_RESET_SECRET=your_64_hex_char_password_reset_secret_here
EMAIL_VERIFICATION_SECRET=your_64_hex_char_email_verification_secret_here
API_KEY_SECRET=your_64_hex_char_api_key_secret_here

# ── Data Encryption & PII Security ────────────────────────────────────────────
AES_256_KEY=your_64_hex_char_aes256_key_here
ENCRYPTION_KEY=your_64_hex_char_encryption_key_here
KYC_ENCRYPTION_KEY=your_64_hex_char_kyc_encryption_key_here

# ── Razorpay Payment Gateway Credentials ──────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ── Google OAuth 2.0 Integration ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret
GOOGLE_CALLBACK_URL=https://pg-management-system-boxb.onrender.com/api/v1/auth/google/callback

# ── SMTP Email Gateway (Brevo / SendGrid / Nodemailer) ───────────────────────
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_user_email@domain.com
SMTP_PASS=xsmtpsib-your_brevo_smtp_password
EMAIL_FROM="RoomBae Enterprise <noreply@roombae.com>"

# ── Cloudinary Media Storage ──────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER_PREFIX=RoomBae-Production

# ── Firebase Admin SDK (Phone Authentication & Notifications) ─────────────────
FIREBASE_PROJECT_ID=roombae-app
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@roombae-app.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_FIREBASE_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ── reCAPTCHA Enterprise / v2 Bot Protection ──────────────────────────────────
RECAPTCHA_SITE_KEY=6LfgNnYtAAAAAABdvCLaqfA6ucDLdBKTxy8sLCwfn
RECAPTCHA_MIN_SCORE=0.5
RECAPTCHA_ENABLED=true

# ── Miscellaneous System Controls ────────────────────────────────────────────
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
UPLOAD_MAX_SIZE=10485760
ALLOWED_IMAGE_TYPES=image/jpeg,image/jpg,image/png,image/webp,image/avif
ALLOWED_DOCUMENT_TYPES=application/pdf
NOMINATIM_USER_AGENT=RoomBae-PG-Management/1.0
CLUSTER_MODE=false

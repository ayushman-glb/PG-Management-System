# ==============================================================================
# RoomBae Enterprise SaaS — Production Environment Variables Template (.env.example)
# ==============================================================================

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:5000
API_PREFIX=/api/v1

DATABASE_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/roombae?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/roombae?retryWrites=true&w=majority
REDIS_URL=redis://localhost:6379

JWT_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
SESSION_SECRET=your_session_secret_here
COOKIE_SECRET=your_cookie_secret_here
CSRF_SECRET=your_csrf_secret_here

PASSWORD_RESET_SECRET=your_password_reset_secret_here
EMAIL_VERIFICATION_SECRET=your_email_verification_secret_here
API_KEY_SECRET=your_api_key_secret_here

AES_256_KEY=your_aes256_key_here
ENCRYPTION_KEY=your_encryption_key_here
KYC_ENCRYPTION_KEY=your_kyc_encryption_key_here

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass
EMAIL_FROM="RoomBae Enterprise <noreply@roombae.com>"

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

FIREBASE_PROJECT_ID=roombae-cff13
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@roombae.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_FIREBASE_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

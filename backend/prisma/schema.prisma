datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  RESIDENT
  PG_OWNER
  ADMIN
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum PGGenderType {
  BOYS
  GIRLS
  CO_LIVING
}

enum PGStatus {
  PENDING_ADMIN_VERIFICATION
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  SUSPENDED
}

enum RoomType {
  SINGLE
  DOUBLE
  TRIPLE
  FOUR_SHARING
  CUSTOM
}

enum BedStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  MAINTENANCE
  ARCHIVED
}

enum SubscriptionTier {
  BASIC
  PROFESSIONAL
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  EXPIRED
  CANCELLED
  GRACE_PERIOD
}

enum BookingStatus {
  APPLIED
  WAITING
  ACCEPTED
  PAYMENT_PENDING
  PAYMENT_VERIFIED
  ONBOARDING
  ROOM_ALLOCATION_PENDING
  ROOM_ALLOCATED
  CONFIRMED
  REJECTED
  CANCELLED
  EXPIRED
  PAYMENT_FAILED
  PAYMENT_REFUNDED
  NO_SHOW
  COMPLETED
}

enum RoomChangeStatus {
  REQUESTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  COMPLETED
  CANCELLED
}

enum AgreementStatus {
  PENDING_SIGNATURE
  SIGNED_BY_RESIDENT
  SIGNED_BY_OWNER
  COMPLETED
  EXPIRED
  TERMINATED
}

enum SignatureType {
  DRAWN
  TYPED
  UPLOADED
}

enum InvoiceStatus {
  DRAFT
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
  CANCELLED
}

enum InvoiceItemType {
  RENT
  DEPOSIT
  FINE
  ELECTRICITY
  MEAL
  MAINTENANCE
  OTHER
}

enum PaymentMethod {
  RAZORPAY
  UPI_MANUAL
  BANK_TRANSFER_MANUAL
  CASH
}

enum PaymentPurpose {
  BOOKING_ADVANCE
  SECURITY_DEPOSIT
  MONTHLY_RENT
  FINE
  SUBSCRIPTION
  OTHER
}

enum PaymentStatus {
  INITIATED
  PENDING_VERIFICATION
  VERIFIED
  FAILED
  REFUNDED
}

enum RefundReason {
  BOOKING_CANCELLATION
  MOVE_OUT_DEPOSIT
  FAILED_PAYMENT
  DISPUTE_ADJUSTMENT
  ADMIN_OVERRIDE
}

enum RefundStatus {
  REQUESTED
  APPROVED
  PROCESSED
  REJECTED
}

enum FineType {
  LATE_RENT
  DAMAGE
  RULE_VIOLATION
  OTHER
}

enum FineStatus {
  PENDING
  APPLIED_TO_INVOICE
  WAIVED
  PAID
}

enum ComplaintCategory {
  MAINTENANCE
  CLEANLINESS
  FOOD
  WIFI
  NOISE
  SECURITY
  BILLING
  OTHER
}

enum ComplaintPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ComplaintStatus {
  OPEN
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
  CLOSED
  REOPENED
}

enum NotificationType {
  BOOKING
  PAYMENT
  RENT_DUE
  FINE
  COMPLAINT
  ANNOUNCEMENT
  SECURITY
  SYSTEM
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
}

enum DocumentType {
  AADHAAR_FRONT
  AADHAAR_BACK
  PAN_CARD
  PASSPORT
  POLICE_VERIFICATION
  PROPERTY_DEED
  ELECTRICITY_BILL
  RENT_AGREEMENT
  OTHER
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum OTPType {
  EMAIL_VERIFICATION
  PHONE_VERIFICATION
  TWO_FACTOR
  PASSWORD_RESET
}

enum LegalDocType {
  TERMS_AND_CONDITIONS
  PRIVACY_POLICY
  BOOKING_POLICY
  HOUSE_RULES
}

// ==========================================
// MODELS
// ==========================================

model User {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  email              String    @unique
  phone              String?   @unique
  username           String    @unique
  passwordHash       String?
  role               Role      @default(RESIDENT)
  isActive           Boolean   @default(true)
  isSuspended        Boolean   @default(false)
  emailVerified      Boolean   @default(false)
  phoneVerified      Boolean   @default(false)
  twoFactorEnabled   Boolean   @default(true)
  isProfileComplete  Boolean   @default(true)
  currentAddress     String?
  avatarUrl          String?
  tokenVersion       Int       @default(0)
  deletionRequested  Boolean   @default(false)
  deletionReason     String?
  deletionRequestedAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  authIdentities     AuthIdentity[]
  profile            UserProfile?
  sessions           Session[]
  devices            Device[]
  otps               OTP[]
  legalAcceptances   LegalAcceptance[]
  ownedPGs           PG[]                 @relation("PGOwner")
  subscriptions      Subscription[]
  subscriptionPayments SubscriptionPayment[]
  bookings           Booking[]            @relation("ResidentBookings")
  roomAllocations    RoomAllocation[]     @relation("ResidentAllocations")
  allocatedByMe      RoomAllocation[]     @relation("AllocatedByOwner")
  roomChangeRequests RoomChangeRequest[]  @relation("ResidentRoomChanges")
  residentAgreements Agreement[]          @relation("ResidentAgreements")
  ownerAgreements    Agreement[]          @relation("OwnerAgreements")
  digitalSignatures  DigitalSignature[]
  invoices           Invoice[]            @relation("ResidentInvoices")
  paymentsMade       Payment[]            @relation("PayerPayments")
  paymentsReceived   Payment[]            @relation("PayeePayments")
  verifiedPayments   Payment[]            @relation("VerifiedPayments")
  refunds            Refund[]             @relation("ResidentRefunds")
  fines              Fine[]               @relation("ResidentFines")
  rentSchedules      RentSchedule[]       @relation("ResidentRentSchedules")
  complaintsCreated  Complaint[]          @relation("ResidentComplaints")
  complaintMessages  ComplaintMessage[]
  complaintHistories ComplaintStatusHistory[]
  notifications      Notification[]
  notificationPref   NotificationPreference?
  reviews            Review[]
  expensesRecorded   Expense[]            @relation("OwnerExpenses")
  revenueRecorded    RevenueEntry[]       @relation("OwnerRevenue")
  documents          Document[]           @relation("UserDocuments")
  verifiedDocuments  Document[]           @relation("VerifierDocuments")
  auditLogs          AuditLog[]           @relation("UserAuditLogs")

  @@index([role])
}

model AuthIdentity {
  id              String       @id @default(auto()) @map("_id") @db.ObjectId
  userId          String       @db.ObjectId
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        AuthProvider
  providerSubject String
  providerEmail   String?
  emailVerified   Boolean      @default(true)
  providerProfile Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  lastUsedAt      DateTime     @default(now())

  @@unique([provider, providerSubject])
  @@index([userId])
  @@index([providerEmail])
}

model UserProfile {
  id                    String    @id @default(auto()) @map("_id") @db.ObjectId
  userId                String    @unique @db.ObjectId
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName             String
  lastName              String
  dateOfBirth           DateTime?
  gender                Gender?
  occupation            String?
  companyOrCollege      String?
  emergencyContactName  String?
  emergencyContactPhone String?
  emergencyContactRelation String?
  bloodGroup            String?
  idProofType           DocumentType?
  idProofNumber         String?
  idProofUrl            String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Session {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  userId           String    @db.ObjectId
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String
  deviceId         String?
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  isRevoked        Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId])
  @@index([refreshTokenHash])
}

model Device {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  userId           String    @db.ObjectId
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  visitorId        String
  deviceLabel      String
  browser          String?
  os               String?
  deviceType       String?
  ipAddress        String?
  screenResolution String?
  isPrimary        Boolean   @default(false)
  lastActiveAt     DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId])
  @@index([visitorId])
}

model OTP {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  userId      String?   @db.ObjectId
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  identifier  String    // Email or Phone number
  codeHash    String
  type        OTPType
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  expiresAt   DateTime
  isUsed      Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@index([identifier, type])
}

model LegalDocument {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  type        LegalDocType
  title       String
  version     String
  content     String
  isActive    Boolean        @default(true)
  publishedAt DateTime       @default(now())
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  acceptances LegalAcceptance[]

  @@index([type, version])
}

model LegalAcceptance {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  userId          String        @db.ObjectId
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentId      String        @db.ObjectId
  document        LegalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentType    LegalDocType
  documentVersion String
  ipAddress       String?
  userAgent       String?
  acceptedAt      DateTime      @default(now())

  @@index([userId, documentType])
}

model PG {
  id                String       @id @default(auto()) @map("_id") @db.ObjectId
  ownerId           String       @db.ObjectId
  owner             User         @relation("PGOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  name              String
  description       String
  genderType        PGGenderType
  rules             String[]
  noticePeriodDays  Int          @default(30)
  gateClosingTime   String?
  status            PGStatus     @default(PENDING_ADMIN_VERIFICATION)
  rejectionReason   String?
  adminNotes        String?
  basePrice         Float        @default(0)
  depositMonths     Int          @default(1)
  gstNumber         String?
  contactPhone      String?
  contactEmail      String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  location          PGLocation?
  images            PGImage[]
  amenities         PGAmenity[]
  floors            Floor[]
  rooms             Room[]
  beds              Bed[]
  mealPlans         MealPlan[]
  bookings          Booking[]
  roomAllocations   RoomAllocation[]
  agreements        Agreement[]
  invoices          Invoice[]
  payments          Payment[]
  refunds           Refund[]
  fines             Fine[]
  rentSchedules     RentSchedule[]
  complaints        Complaint[]
  reviews           Review[]
  expenses          Expense[]
  revenueEntries    RevenueEntry[]

  @@index([ownerId])
  @@index([status])
  @@index([genderType])
}

model PGLocation {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  pgId          String   @unique @db.ObjectId
  pg            PG       @relation(fields: [pgId], references: [id], onDelete: Cascade)
  address       String
  locality      String
  city          String
  state         String
  pincode       String
  country       String   @default("India")
  latitude      Float
  longitude     Float
  googleMapsUrl String?
  placeId       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([city])
  @@index([locality])
}

model PGImage {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  pgId       String   @db.ObjectId
  pg         PG       @relation(fields: [pgId], references: [id], onDelete: Cascade)
  publicId   String
  secureUrl  String
  caption    String?
  isFeatured Boolean  @default(false)
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([pgId])
}

model Amenity {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  name        String      @unique
  category    String      // ROOM, PG, SECURITY, FOOD
  icon        String?
  isDefault   Boolean     @default(false)
  createdAt   DateTime    @default(now())

  pgAmenities PGAmenity[]
}

model PGAmenity {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  pgId        String   @db.ObjectId
  pg          PG       @relation(fields: [pgId], references: [id], onDelete: Cascade)
  amenityId   String   @db.ObjectId
  amenity     Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)
  isAvailable Boolean  @default(true)
  notes       String?

  @@unique([pgId, amenityId])
  @@index([pgId])
}

model Floor {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  pgId         String   @db.ObjectId
  pg           PG       @relation(fields: [pgId], references: [id], onDelete: Cascade)
  floorNumber  Int
  floorName    String
  wifiSsid     String?
  wifiPassword String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  rooms        Room[]
  roomAllocations RoomAllocation[]

  @@index([pgId])
}

model Room {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  floorId             String   @db.ObjectId
  floor               Floor    @relation(fields: [floorId], references: [id], onDelete: Cascade)
  pgId                String   @db.ObjectId
  pg                  PG       @relation(fields: [pgId], references: [id], onDelete: Cascade)
  roomNumber          String
  roomType            RoomType
  allowedGender       Gender?
  baseRent            Float
  depositAmount       Float
  isAc                Boolean  @default(false)
  hasAttachedBathroom Boolean  @default(false)
  status              BedStatus @default(AVAILABLE) // ACTIVE/AVAILABLE/MAINTENANCE
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  beds                Bed[]
  bookings            Booking[]
  roomAllocations     RoomAllocation[]
  rentSchedules       RentSchedule[]
  complaints          Complaint[]

  @@index([pgId])
  @@index([floorId])
}

model Bed {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  roomId            String    @db.ObjectId
  room              Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  pgId              String    @db.ObjectId
  pg                PG        @relation(fields: [pgId], references: [id], onDelete: Cascade)
  bedNumber         String
  status            BedStatus @default(AVAILABLE)
  currentResidentId String?   @db.ObjectId
  baseRent          Float
  depositAmount     Float
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  bookings          Booking[]
  roomAllocations   RoomAllocation[]
  roomChangesFrom   RoomChangeRequest[] @relation("OldBed")
  rentSchedules     RentSchedule[]

  @@index([roomId])
  @@index([pgId])
  @@index([status])
}

model MealPlan {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  pgId            String   @db.ObjectId
  pg              PG       @relation(fields: [pgId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  isIncludedInRent Boolean @default(true)
  monthlyPrice    Float    @default(0)
  breakfastTime   String?
  lunchTime       String?
  dinnerTime      String?
  snacksTime      String?
  isVegOnly       Boolean  @default(false)
  weeklyMenu      String?  // JSON string or summary
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([pgId])
}

model SubscriptionPlan {
  id           String           @id @default(auto()) @map("_id") @db.ObjectId
  name         String           @unique // "Basic", "Professional", "Enterprise"
  tier         SubscriptionTier @unique
  monthlyPrice Float            // 1499, 2499, 4999
  pgLimit      Int              // 4, 10, 20
  description  String
  features     String[]
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id                    String             @id @default(auto()) @map("_id") @db.ObjectId
  ownerId               String             @db.ObjectId
  owner                 User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  planId                String             @db.ObjectId
  plan                  SubscriptionPlan   @relation(fields: [planId], references: [id])
  status                SubscriptionStatus @default(ACTIVE)
  currentPeriodStart    DateTime           @default(now())
  currentPeriodEnd      DateTime
  autoRenew             Boolean            @default(true)
  razorpaySubscriptionId String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  payments              SubscriptionPayment[]

  @@index([ownerId])
  @@index([status])
}

model SubscriptionPayment {
  id                    String       @id @default(auto()) @map("_id") @db.ObjectId
  subscriptionId        String       @db.ObjectId
  subscription          Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  ownerId               String       @db.ObjectId
  owner                 User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  amount                Float
  currency              String       @default("INR")
  status                PaymentStatus @default(INITIATED)
  razorpayOrderId       String?
  razorpayPaymentId     String?
  razorpaySignature     String?
  paidAt                DateTime?
  createdAt             DateTime     @default(now())

  @@index([subscriptionId])
  @@index([ownerId])
}

model Booking {
  id                 String        @id @default(auto()) @map("_id") @db.ObjectId
  residentId         String        @db.ObjectId
  resident           User          @relation("ResidentBookings", fields: [residentId], references: [id], onDelete: Cascade)
  pgId               String        @db.ObjectId
  pg                 PG            @relation(fields: [pgId], references: [id], onDelete: Cascade)
  roomId             String?       @db.ObjectId
  room               Room?         @relation(fields: [roomId], references: [id])
  bedId              String?       @db.ObjectId
  bed                Bed?          @relation(fields: [bedId], references: [id])
  roomType           RoomType
  preferredMoveInDate DateTime
  expectedStayMonths Int           @default(1)
  status             BookingStatus @default(APPLIED)
  rentAmount         Float
  depositAmount      Float
  advanceAmountPaid  Float         @default(0)
  rejectionReason    String?
  cancellationReason String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  statusHistory      BookingStatusHistory[]
  roomAllocations    RoomAllocation[]
  agreements         Agreement[]
  invoices           Invoice[]
  payments           Payment[]
  refunds            Refund[]

  @@index([residentId])
  @@index([pgId])
  @@index([status])
}

model BookingStatusHistory {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  bookingId   String        @db.ObjectId
  booking     Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  fromStatus  BookingStatus
  toStatus    BookingStatus
  changedById String?       @db.ObjectId
  reason      String?
  createdAt   DateTime      @default(now())

  @@index([bookingId])
}

model RoomAllocation {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  bookingId      String    @db.ObjectId
  booking        Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  residentId     String    @db.ObjectId
  resident       User      @relation("ResidentAllocations", fields: [residentId], references: [id], onDelete: Cascade)
  pgId           String    @db.ObjectId
  pg             PG        @relation(fields: [pgId], references: [id], onDelete: Cascade)
  floorId        String    @db.ObjectId
  floor          Floor     @relation(fields: [floorId], references: [id])
  roomId         String    @db.ObjectId
  room           Room      @relation(fields: [roomId], references: [id])
  bedId          String    @db.ObjectId
  bed            Bed       @relation(fields: [bedId], references: [id])
  rent           Float
  deposit        Float
  checkInDate    DateTime  @default(now())
  checkOutDate   DateTime?
  isActive       Boolean   @default(true)
  allocatedAt    DateTime  @default(now())
  allocatedById  String    @db.ObjectId
  allocatedBy    User      @relation("AllocatedByOwner", fields: [allocatedById], references: [id])

  agreements     Agreement[]
  roomChanges    RoomChangeRequest[]

  @@index([residentId])
  @@index([pgId])
  @@index([bedId])
  @@index([isActive])
}

model RoomChangeRequest {
  id                  String           @id @default(auto()) @map("_id") @db.ObjectId
  residentId          String           @db.ObjectId
  resident            User             @relation("ResidentRoomChanges", fields: [residentId], references: [id], onDelete: Cascade)
  currentAllocationId String           @db.ObjectId
  currentAllocation   RoomAllocation   @relation(fields: [currentAllocationId], references: [id], onDelete: Cascade)
  currentBedId        String           @db.ObjectId
  currentBed          Bed              @relation("OldBed", fields: [currentBedId], references: [id])
  requestedPgId       String           @db.ObjectId
  requestedRoomType   RoomType
  reason              String
  status              RoomChangeStatus @default(REQUESTED)
  adminNotes          String?
  newAllocationId     String?          @db.ObjectId
  requestedAt         DateTime         @default(now())
  reviewedAt          DateTime?

  @@index([residentId])
  @@index([status])
}

model Agreement {
  id                 String          @id @default(auto()) @map("_id") @db.ObjectId
  bookingId          String          @db.ObjectId
  booking            Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  residentId         String          @db.ObjectId
  resident           User            @relation("ResidentAgreements", fields: [residentId], references: [id], onDelete: Cascade)
  ownerId            String          @db.ObjectId
  owner              User            @relation("OwnerAgreements", fields: [ownerId], references: [id], onDelete: Cascade)
  pgId               String          @db.ObjectId
  pg                 PG              @relation(fields: [pgId], references: [id], onDelete: Cascade)
  allocationId       String?         @db.ObjectId
  allocation         RoomAllocation? @relation(fields: [allocationId], references: [id])
  agreementNumber    String          @unique
  status             AgreementStatus @default(PENDING_SIGNATURE)
  rentAmount         Float
  depositAmount      Float
  lockInPeriodMonths Int             @default(3)
  noticePeriodDays   Int             @default(30)
  startDate          DateTime
  endDate            DateTime
  agreementPdfUrl    String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  signatures         DigitalSignature[]

  @@index([residentId])
  @@index([ownerId])
  @@index([pgId])
}

model DigitalSignature {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  agreementId   String        @db.ObjectId
  agreement     Agreement     @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  signerId      String        @db.ObjectId
  signer        User          @relation(fields: [signerId], references: [id], onDelete: Cascade)
  signerRole    Role
  signatureType SignatureType
  signatureData String        // Data URL or string identifier
  ipAddress     String?
  signedAt      DateTime      @default(now())

  @@index([agreementId])
}

model Invoice {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  residentId      String        @db.ObjectId
  resident        User          @relation("ResidentInvoices", fields: [residentId], references: [id], onDelete: Cascade)
  pgId            String        @db.ObjectId
  pg              PG            @relation(fields: [pgId], references: [id], onDelete: Cascade)
  bookingId       String?       @db.ObjectId
  booking         Booking?      @relation(fields: [bookingId], references: [id])
  invoiceNumber   String        @unique
  billingMonth    Int           // 1 to 12
  billingYear     Int
  issueDate       DateTime      @default(now())
  dueDate         DateTime
  gracePeriodDays Int           @default(5)
  subtotal        Float
  gstPercentage   Float         @default(18.0)
  gstAmount       Float         @default(0)
  fineAmount      Float         @default(0)
  totalAmount     Float
  amountPaid      Float         @default(0)
  balanceDue      Float
  status          InvoiceStatus @default(UNPAID)
  pdfUrl          String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items           InvoiceItem[]
  payments        Payment[]
  fines           Fine[]

  @@index([residentId])
  @@index([pgId])
  @@index([status])
}

model InvoiceItem {
  id          String          @id @default(auto()) @map("_id") @db.ObjectId
  invoiceId   String          @db.ObjectId
  invoice     Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  itemType    InvoiceItemType @default(RENT)
  unitPrice   Float
  quantity    Int             @default(1)
  total       Float

  @@index([invoiceId])
}

model Payment {
  id                String         @id @default(auto()) @map("_id") @db.ObjectId
  invoiceId         String?        @db.ObjectId
  invoice           Invoice?       @relation(fields: [invoiceId], references: [id])
  bookingId         String?        @db.ObjectId
  booking           Booking?       @relation(fields: [bookingId], references: [id])
  payerId           String         @db.ObjectId
  payer             User           @relation("PayerPayments", fields: [payerId], references: [id], onDelete: Cascade)
  payeeId           String?        @db.ObjectId
  payee             User?          @relation("PayeePayments", fields: [payeeId], references: [id])
  pgId              String?        @db.ObjectId
  pg                PG?            @relation(fields: [pgId], references: [id])
  amount            Float
  currency          String         @default("INR")
  paymentMethod     PaymentMethod
  purpose           PaymentPurpose
  status            PaymentStatus  @default(INITIATED)
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?
  manualUtr         String?
  manualProofUrl    String?
  manualSubmittedAt DateTime?
  verifiedById      String?        @db.ObjectId
  verifiedBy        User?          @relation("VerifiedPayments", fields: [verifiedById], references: [id])
  verifiedAt        DateTime?
  rejectionReason   String?
  receiptNumber     String?        @unique
  receiptPdfUrl     String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  refunds           Refund[]

  @@index([payerId])
  @@index([invoiceId])
  @@index([bookingId])
  @@index([status])
}

model PaymentWebhook {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  eventId     String   @unique
  eventType   String
  payload     String   // JSON string
  isProcessed Boolean  @default(false)
  processedAt DateTime?
  error       String?
  createdAt   DateTime @default(now())
}

model Refund {
  id               String       @id @default(auto()) @map("_id") @db.ObjectId
  paymentId        String?      @db.ObjectId
  payment          Payment?     @relation(fields: [paymentId], references: [id])
  bookingId        String?      @db.ObjectId
  booking          Booking?     @relation(fields: [bookingId], references: [id])
  residentId       String       @db.ObjectId
  resident         User         @relation("ResidentRefunds", fields: [residentId], references: [id], onDelete: Cascade)
  pgId             String       @db.ObjectId
  pg               PG           @relation(fields: [pgId], references: [id], onDelete: Cascade)
  amount           Float
  reason           RefundReason
  status           RefundStatus @default(REQUESTED)
  approvedById     String?      @db.ObjectId
  razorpayRefundId String?
  notes            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([residentId])
  @@index([pgId])
}

model Fine {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  residentId  String     @db.ObjectId
  resident    User       @relation("ResidentFines", fields: [residentId], references: [id], onDelete: Cascade)
  invoiceId   String?    @db.ObjectId
  invoice     Invoice?   @relation(fields: [invoiceId], references: [id])
  pgId        String     @db.ObjectId
  pg          PG         @relation(fields: [pgId], references: [id], onDelete: Cascade)
  fineType    FineType
  amount      Float
  reason      String
  status      FineStatus @default(PENDING)
  appliedAt   DateTime   @default(now())
  waivedById  String?    @db.ObjectId
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([residentId])
  @@index([pgId])
}

model RentSchedule {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  residentId        String   @db.ObjectId
  resident          User     @relation("ResidentRentSchedules", fields: [residentId], references: [id], onDelete: Cascade)
  pgId              String   @db.ObjectId
  pg                PG       @relation(fields: [pgId], references: [id], onDelete: Cascade)
  roomId            String   @db.ObjectId
  room              Room     @relation(fields: [roomId], references: [id])
  bedId             String   @db.ObjectId
  bed               Bed      @relation(fields: [bedId], references: [id])
  monthlyRent       Float
  billingDayOfMonth Int      @default(1)
  dueDayOfMonth     Int      @default(5)
  graceDays         Int      @default(5)
  lateFinePerDay    Float    @default(50)
  maxFineAmount     Float    @default(1000)
  isActive          Boolean  @default(true)
  nextBillingDate   DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([residentId])
  @@index([pgId])
}

model Complaint {
  id                      String            @id @default(auto()) @map("_id") @db.ObjectId
  residentId              String            @db.ObjectId
  resident                User              @relation("ResidentComplaints", fields: [residentId], references: [id], onDelete: Cascade)
  pgId                    String            @db.ObjectId
  pg                      PG                @relation(fields: [pgId], references: [id], onDelete: Cascade)
  roomId                  String?           @db.ObjectId
  room                    Room?             @relation(fields: [roomId], references: [id])
  category                ComplaintCategory
  title                   String
  description             String
  priority                ComplaintPriority @default(MEDIUM)
  status                  ComplaintStatus   @default(OPEN)
  resolutionNotes         String?
  resolvedAt              DateTime?
  closedAt                DateTime?
  residentAcknowledgedAt  DateTime?
  residentRejectionReason String?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  messages                ComplaintMessage[]
  histories               ComplaintStatusHistory[]

  @@index([residentId])
  @@index([pgId])
  @@index([status])
}

model ComplaintMessage {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  complaintId String    @db.ObjectId
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  senderId    String    @db.ObjectId
  sender      User      @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderRole  Role
  message     String
  attachments String[]
  createdAt   DateTime  @default(now())

  @@index([complaintId])
}

model ComplaintStatusHistory {
  id          String          @id @default(auto()) @map("_id") @db.ObjectId
  complaintId String          @db.ObjectId
  complaint   Complaint       @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  fromStatus  ComplaintStatus
  toStatus    ComplaintStatus
  changedById String          @db.ObjectId
  changedBy   User            @relation(fields: [changedById], references: [id], onDelete: Cascade)
  remarks     String?
  createdAt   DateTime        @default(now())

  @@index([complaintId])
}

model Notification {
  id        String              @id @default(auto()) @map("_id") @db.ObjectId
  userId    String              @db.ObjectId
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      NotificationType
  channel   NotificationChannel @default(IN_APP)
  isRead    Boolean             @default(false)
  readAt    DateTime?
  metadata  String?             // JSON string
  createdAt DateTime            @default(now())

  @@index([userId])
  @@index([isRead])
}

model NotificationPreference {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  userId             String   @unique @db.ObjectId
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailNotifications Boolean  @default(true)
  smsNotifications   Boolean  @default(true)
  inAppNotifications Boolean  @default(true)
  bookingAlerts      Boolean  @default(true)
  paymentAlerts      Boolean  @default(true)
  complaintAlerts    Boolean  @default(true)
  marketingAlerts    Boolean  @default(false)
  updatedAt          DateTime @updatedAt
}

model Review {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  residentId          String   @db.ObjectId
  resident            User     @relation(fields: [residentId], references: [id], onDelete: Cascade)
  pgId                String   @db.ObjectId
  pg                  PG       @relation(fields: [pgId], references: [id], onDelete: Cascade)
  rating              Int      // 1 to 5
  cleanlinessRating   Int?
  foodRating          Int?
  valueForMoneyRating Int?
  reviewText          String
  isApproved          Boolean  @default(true)
  isReported          Boolean  @default(false)
  adminRemarks        String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([pgId])
  @@index([residentId])
}

model Expense {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  pgId          String   @db.ObjectId
  pg            PG       @relation(fields: [pgId], references: [id], onDelete: Cascade)
  ownerId       String   @db.ObjectId
  owner         User     @relation("OwnerExpenses", fields: [ownerId], references: [id], onDelete: Cascade)
  category      String   // ELECTRICITY, WATER, FOOD_GROCERY, MAINTENANCE, STAFF_SALARY, INTERNET, TAX, OTHER
  amount        Float
  date          DateTime @default(now())
  description   String
  receiptUrl    String?
  isManualEntry Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([pgId])
  @@index([ownerId])
}

model RevenueEntry {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  pgId        String   @db.ObjectId
  pg          PG       @relation(fields: [pgId], references: [id], onDelete: Cascade)
  ownerId     String   @db.ObjectId
  owner       User     @relation("OwnerRevenue", fields: [ownerId], references: [id], onDelete: Cascade)
  source      String   // RENT, DEPOSIT_NON_REFUNDABLE, FINE, FOOD_EXTRA, OTHER
  amount      Float
  date        DateTime @default(now())
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([pgId])
  @@index([ownerId])
}

model Document {
  id             String             @id @default(auto()) @map("_id") @db.ObjectId
  userId         String             @db.ObjectId
  user           User               @relation("UserDocuments", fields: [userId], references: [id], onDelete: Cascade)
  documentType   DocumentType
  documentNumber String?

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "windows"]
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  SUPER_ADMIN
  ADMIN
  OWNER
  MANAGER
  STAFF
  RESIDENT
  PUBLIC
}

enum ResidentStatus {
  ACTIVE // 🟢
  INACTIVE // ⚫
  HOME // 🏠
  ON_LEAVE // 🟡
  HOLD // 🟠
  LEAVING // 🔴
  CHECKED_OUT // ⚪
  WAITING // 🔵
}

enum PGStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  UPCOMING
}

enum HoldStatus {
  PENDING
  APPROVED
  REJECTED
  WAITING_DOCUMENTS
  WAITING_PAYMENT
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum AgreementStatus {
  PENDING
  SIGNED_BY_RESIDENT
  SIGNED_BY_OWNER
  COMPLETED
  EXPIRED
  RENEWAL_DUE
}

enum FoodPreference {
  VEG
  NON_VEG
  JAIN
}

enum RoomType {
  SINGLE
  DOUBLE
  TRIPLE
  FOUR_SHARING
  FIVE_SHARING
  CUSTOM
}

enum WashroomType {
  ATTACHED
  COMMON
}

enum ACType {
  AC
  NON_AC
}

enum BedStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  HOLD
  MAINTENANCE
  CLEANING
  BLOCKED
  INACTIVE
  LOCKED_FOR_BOOKING
}

enum RoomTransferStatus {
  PENDING
  REVIEWING
  APPROVED
  REJECTED
  WAITING_ROOM
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum BedHoldReason {
  MAINTENANCE
  RESERVED
  VIP_BOOKING
  CLEANING
  BLOCKED
  FUTURE_BOOKING
}

enum PaymentStatus {
  PAID
  PENDING
  LATE
  REFUNDED
  FAILED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum PassStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum OwnerKYCStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum BusinessType {
  INDIVIDUAL
  PARTNERSHIP
  LLP
  PVT_LIMITED
  TRUST
  SOCIETY
}

enum PropertyType {
  HOSTEL
  PG
  APARTMENT
  VILLA
  BUILDING
  INDEPENDENT_HOUSE
}

enum PropertyOwnershipType {
  OWNED
  LEASED
  RENTED
  MANAGED
}

enum SubscriptionPlanType {
  STARTER
  PROFESSIONAL
  BUSINESS
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum FineType {
  LATE_RENT
  DAMAGE
  ELECTRICITY
  WATER
  CLEANING
  CUSTOM
}

enum FineCalculationType {
  FLAT
  PERCENTAGE
  PER_DAY
}

enum FineStatus {
  UNPAID
  PAID
  WAIVED
}

enum DraftStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

// ==========================================
// RBAC & ADMIN MODELS
// ==========================================

model Admin {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  email        String   @unique
  passwordHash String
  roleId       String   @db.ObjectId
  role         RbacRole @relation(fields: [roleId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model RbacRole {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  name          Role         @unique
  description   String?
  permissionIds String[]     @db.ObjectId
  permissions   Permission[] @relation(fields: [permissionIds], references: [id])
  admins        Admin[]
  createdAt     DateTime     @default(now())
}

model Permission {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  action    String // e.g. "create:pg", "read:resident"
  resource  String
  roleIds   String[]   @db.ObjectId
  roles     RbacRole[] @relation(fields: [roleIds], references: [id])
  createdAt DateTime   @default(now())
}

// ==========================================
// USER & OWNER MODELS
// ==========================================

model User {
  id                 String          @id @default(auto()) @map("_id") @db.ObjectId
  email              String          @unique
  passwordHash       String?
  name               String
  residentCode       String?
  googleSubId        String?         
  avatarUrl          String?
  role               Role            @default(PUBLIC)
  phone              String?
  phoneVerified      Boolean         @default(false)
  isPhoneVerified    Boolean         @default(false)
  phoneVerifiedAt    DateTime?
  emailVerified      Boolean         @default(false)
  twoFactorEnabled   Boolean         @default(false)
  twoFactorMethod    String?         @default("NONE")
  authProvider       String?         @default("LOCAL")
  termsAccepted      Boolean         @default(true)
  accountStatus      String          @default("ACTIVE")
  verificationStatus String          @default("VERIFIED")
  lastLogin          DateTime?
  phoneOtp           String?
  phoneOtpExpiresAt  DateTime?
  emailOtp           String?
  emailOtpExpiresAt  DateTime?
  twoFactorSecret    String?
  is2FAEnabled       Boolean         @default(false)
  otpSecret          String?
  otpExpiresAt       DateTime?
  tokenVersion       Int             @default(0)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  ownerProfile       Owner?
  residentProfile    Resident?
  loginHistories     LoginHistory[]
  deviceHistories    DeviceHistory[]
  auditLogs          ActivityLog[]
  shortlists         Shortlist[]
  tours              Tour[]
  rentalApplications Application[]
  tenantThreads      ChatThread[]   @relation("TenantThreads")
  ownerThreads       ChatThread[]   @relation("OwnerThreads")
  refreshTokens      RefreshToken[]
  passwordResets     PasswordResetToken[]
  userDevices        UserDevice[]
  securityAuditEvents SecurityAuditEvent[]

  @@index([residentCode])
  @@index([phone])
}

model PhoneOTP {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  phone       String
  hashedOtp   String
  expiresAt   DateTime
  attempts    Int      @default(0)
  resendCount Int      @default(0)
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([phone])
  @@index([expiresAt])
}

model RefreshToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  revokedAt DateTime?
  replacedBy String?
  ipAddress String?
  userAgent String?

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model OtpToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  phone     String?
  email     String?
  otp       String
  purpose   String // PHONE_VERIFICATION, EMAIL_VERIFICATION, PASSWORD_RESET, 2FA
  attempts  Int      @default(0)
  verified  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model LoginHistory {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  ipAddress String
  userAgent String
  status    String // SUCCESS, FAILED
  createdAt DateTime @default(now())
}

model UserDevice {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  userId          String    @db.ObjectId
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  visitorIdHash   String
  provider        String    @default("fingerprintjs")
  providerVersion String?
  deviceLabel     String
  status          String    @default("NEW") // NEW, TRUSTED, BLOCKED, REVOKED
  trustLevel      String    @default("UNTRUSTED") // TRUSTED, UNTRUSTED
  lastIpHash      String?
  userAgentHash   String?
  failedAttempts  Int       @default(0)
  firstSeenAt     DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())
  lastLoginAt     DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, visitorIdHash])
  @@index([userId])
  @@index([visitorIdHash])
  @@index([status])
}

model SecurityAuditEvent {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String?  @db.ObjectId
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  deviceId  String?
  eventType String   // LOGIN_SUCCESS, LOGIN_FAILURE, NEW_DEVICE, DEVICE_TRUSTED, DEVICE_REVOKED, DEVICE_BLOCKED, DEVICE_UNBLOCKED, SUSPICIOUS_LOGIN, STEP_UP_REQUIRED, STEP_UP_SUCCESS, STEP_UP_FAILURE, LOGOUT, SESSION_REVOKED
  severity  String   @default("INFO") // INFO, WARNING, CRITICAL
  riskScore Int      @default(0)
  riskLevel String   @default("LOW") // LOW, MEDIUM, HIGH, CRITICAL
  ipAddress String?
  userAgent String?
  requestId String?
  metadata  String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([eventType])
  @@index([createdAt])
}

model DeviceHistory {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @db.ObjectId
  user       User     @relation(fields: [userId], references: [id])
  deviceId   String
  deviceName String
  ipAddress  String
  lastActive DateTime @default(now())
  createdAt  DateTime @default(now())
}

model Owner {
  id               String        @id @default(auto()) @map("_id") @db.ObjectId
  userId           String        @unique @db.ObjectId
  user             User          @relation(fields: [userId], references: [id])
  name             String
  photo            String
  email            String        @unique
  phone            String
  address          String
  aadhaarNumber    String
  panNumber        String
  upiId            String
  bankName         String
  accountNumber    String
  ifscCode         String
  emergencyContact String
  bio              String?
  kyc              OwnerKYC?
  business         Business?
  subscription     Subscription?
  pgs              PG[]
  agreements       Agreement[]
  kanbanBoards     KanbanBoard[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model OwnerKYC {
  id                    String         @id @default(auto()) @map("_id") @db.ObjectId
  ownerId               String         @unique @db.ObjectId
  owner                 Owner          @relation(fields: [ownerId], references: [id])
  aadhaarNumber         String
  aadhaarDocUrl         String?
  panNumber             String
  panDocUrl             String?
  passportNumber        String?
  passportDocUrl        String?
  drivingLicenseNo      String?
  drivingLicenseUrl     String?
  ownerSelfieUrl        String?
  faceVerificationToken String?
  digitalSignatureUrl   String?
  verificationStatus    OwnerKYCStatus @default(PENDING)
  rejectionReason       String?
  verifiedAt            DateTime?
  verifiedBy            String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
}

model Business {
  id                 String       @id @default(auto()) @map("_id") @db.ObjectId
  ownerId            String       @unique @db.ObjectId
  owner              Owner        @relation(fields: [ownerId], references: [id])
  businessName       String
  businessType       BusinessType @default(INDIVIDUAL)
  gstin              String?
  panNumber          String?
  businessAddress    String
  businessEmail      String
  businessPhone      String
  registrationNumber String?
  tradeLicenseDocUrl String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

model Subscription {
  id                 String               @id @default(auto()) @map("_id") @db.ObjectId
  ownerId            String               @unique @db.ObjectId
  owner              Owner                @relation(fields: [ownerId], references: [id])
  planType           SubscriptionPlanType @default(STARTER)
  status             SubscriptionStatus   @default(ACTIVE)
  maxResidents       Int                  @default(50)
  maxProperties      Int                  @default(3)
  hasAnalytics       Boolean              @default(true)
  hasPrioritySupport Boolean              @default(false)
  hasApiAccess       Boolean              @default(false)
  currentPeriodStart DateTime             @default(now())
  currentPeriodEnd   DateTime
  paymentTxnId       String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
}

// ==========================================
// PROPERTY & ROOM STRUCTURE MODELS
// ==========================================

model PG {
  id                        String                @id @default(auto()) @map("_id") @db.ObjectId
  ownerId                   String                @db.ObjectId
  owner                     Owner                 @relation(fields: [ownerId], references: [id])
  name                      String
  slug                      String                @unique
  logo                      String
  galleryImages             String[]
  description               String
  amenities                 String[] // WiFi, Laundry, Parking, CCTV, Power Backup, Lift, Mess, Security
  rules                     String[]
  rentStartingFrom          Float
  securityDeposit           Float
  latitude                  Float
  longitude                 Float
  address                   String
  city                      String
  pincode                   String
  nearbyColleges            String[]
  nearbyCompanies           String[]
  nearbyMetro               String[]
  capacity                  Int
  currentOccupancy          Int                   @default(0)
  availableBeds             Int
  status                    PGStatus              @default(ACTIVE)
  draftStatus               DraftStatus           @default(DRAFT)
  propertyType              PropertyType          @default(PG)
  ownershipType             PropertyOwnershipType @default(OWNED)
  landlordName              String?
  landlordLeaseAgreementUrl String?
  nocDocumentUrl            String?
  caretakerName             String?
  caretakerPhone            String?
  buildingCount             Int                   @default(1)
  floorCount                Int                   @default(1)
  totalRoomsCount           Int                   @default(0)
  totalBedsCount            Int                   @default(0)
  buildings                 Building[]
  residents                 Resident[]
  agreements                Agreement[]
  transferRequests          RoomTransferRequest[]
  mealPlans                 MealPlan[]
  mealSchedules             MealSchedule[]
  complaints                Complaint[]
  maintenances              Maintenance[]
  visitors                  Visitor[]
  checkIns                  CheckIn[]
  checkOuts                 CheckOut[]
  leaveApplications         LeaveApplication[]
  holdApplications          HoldApplication[]
  payments                  Payment[]
  invoices                  Invoice[]
  attendances               Attendance[]
  kanbanBoards              KanbanBoard[]
  analytics                 Analytics[]
  propertyDocuments         PropertyDocument[]
  fineRules                 FineRule[]
  shortlists                Shortlist[]
  tours                     Tour[]
  applications              Application[]
  chatThreads               ChatThread[]
  moveInInfo                MoveInInfo?
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
}

model PropertyDocument {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  pgId           String   @db.ObjectId
  pg             PG       @relation(fields: [pgId], references: [id])
  documentType   String // PROPERTY_TAX, OWNERSHIP_PROOF, LEASE_AGREEMENT, FIRE_SAFETY, MUNICIPAL_LICENSE, TRADE_LICENSE, GST_CERT
  documentNumber String?
  fileUrl        String
  isApproved     Boolean  @default(false)
  adminNotes     String?
  createdAt      DateTime @default(now())
}

model FineRule {
  id              String              @id @default(auto()) @map("_id") @db.ObjectId
  pgId            String              @db.ObjectId
  pg              PG                  @relation(fields: [pgId], references: [id])
  fineType        FineType
  calculationType FineCalculationType @default(FLAT)
  amount          Float
  percentage      Float?
  perDayRate      Float?
  maxFineAmount   Float?
  gracePeriodDays Int                 @default(3)
  isActive        Boolean             @default(true)
  fines           Fine[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

model Fine {
  id         String     @id @default(auto()) @map("_id") @db.ObjectId
  residentId String     @db.ObjectId
  resident   Resident   @relation(fields: [residentId], references: [id])
  ruleId     String?    @db.ObjectId
  rule       FineRule?  @relation(fields: [ruleId], references: [id])
  fineType   FineType
  amount     Float
  reason     String
  dueDate    DateTime
  status     FineStatus @default(UNPAID)
  waivedBy   String?
  waivedAt   DateTime?
  paidAt     DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Building {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  pgId        String   @db.ObjectId
  pg          PG       @relation(fields: [pgId], references: [id])
  name        String // e.g. "Block A", "Main Tower"
  floorsCount Int
  floors      Floor[]
  createdAt   DateTime @default(now())

  @@index([pgId])
}

model Floor {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  buildingId  String   @db.ObjectId
  building    Building @relation(fields: [buildingId], references: [id])
  floorNumber Int
  rooms       Room[]
  createdAt   DateTime @default(now())

  @@index([buildingId])
}

model Room {
  id           String       @id @default(auto()) @map("_id") @db.ObjectId
  floorId      String       @db.ObjectId
  floor        Floor        @relation(fields: [floorId], references: [id])
  roomNumber   String
  roomType     RoomType
  acType       ACType
  washroomType WashroomType
  rentAmount   Float
  beds         Bed[]
  createdAt    DateTime     @default(now())

  @@index([floorId])
}

model Bed {
  id            String                @id @default(auto()) @map("_id") @db.ObjectId
  roomId        String                @db.ObjectId
  room          Room                  @relation(fields: [roomId], references: [id])
  bedNumber     String // e.g. "101-A"
  status        BedStatus             @default(AVAILABLE)
  isOccupied    Boolean               @default(false)
  lockExpiresAt DateTime?
  resident      Resident?
  holds         BedHold[]
  histories     BedHistory[]
  transferFrom  RoomTransferRequest[] @relation("FromBed")
  transferTo    RoomTransferRequest[] @relation("ToBed")
  createdAt     DateTime              @default(now())

  @@index([roomId])
  @@index([status])
}

// ==========================================
// RESIDENT & KYC MODELS
// ==========================================

model Resident {
  id                String                  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String                  @unique @db.ObjectId
  user              User                    @relation(fields: [userId], references: [id])
  pgId              String?                 @db.ObjectId
  pg                PG?                     @relation(fields: [pgId], references: [id])
  bedId             String?                 @unique @db.ObjectId
  bed               Bed?                    @relation(fields: [bedId], references: [id])
  profilePicture    String?
  name              String
  gender            String?
  age               Int?
  phone             String
  email             String
  permanentAddress  String?
  college           String?
  company           String?
  occupation        String?
  bloodGroup        String?
  foodPreference    FoodPreference          @default(VEG)
  medicalConditions String?
  moveInDate        DateTime?               @default(now())
  expectedMoveOut   DateTime?
  rentDueDate       DateTime?
  status            ResidentStatus          @default(ACTIVE)
  guardian          Guardian?
  emergencyContact  EmergencyContact?
  documents         Document[]
  agreements        Agreement[]
  complaints        Complaint[]
  complaintReplies  ComplaintReply[]
  visitors          Visitor[]
  checkIns          CheckIn[]
  checkOuts         CheckOut[]
  leaveApplications LeaveApplication[]
  holdApplications  HoldApplication[]
  payments          Payment[]
  invoices          Invoice[]
  attendances       Attendance[]
  statusHistories   ResidentStatusHistory[]
  transferRequests  RoomTransferRequest[]
  fines             Fine[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([pgId])
  @@index([status])
}

model Guardian {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  residentId String   @unique @db.ObjectId
  resident   Resident @relation(fields: [residentId], references: [id])
  name       String
  relation   String
  phone      String
  email      String?
  address    String
  createdAt  DateTime @default(now())
}

model EmergencyContact {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  residentId String   @unique @db.ObjectId
  resident   Resident @relation(fields: [residentId], references: [id])
  name       String
  relation   String
  phone      String
  createdAt  DateTime @default(now())
}

model Document {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  residentId     String   @db.ObjectId
  resident       Resident @relation(fields: [residentId], references: [id])
  documentType   String // AADHAAR, PAN, PASSPORT, DRIVING_LICENSE, COLLEGE_ID, OFFICE_ID, PROPERTY_PAPERS
  documentNumber String
  fileUrl        String
  isVerified     Boolean  @default(true)
  createdAt      DateTime @default(now())
}

// ==========================================
// LEGAL RENTAL AGREEMENT & SIGNATURE SYSTEM
// ==========================================

model Agreement {
  id                    String             @id @default(auto()) @map("_id") @db.ObjectId
  agreementNumber       String             @unique
  residentId            String             @db.ObjectId
  resident              Resident           @relation(fields: [residentId], references: [id])
  ownerId               String             @db.ObjectId
  owner                 Owner              @relation(fields: [ownerId], references: [id])
  pgId                  String             @db.ObjectId
  pg                    PG                 @relation(fields: [pgId], references: [id])
  roomNumber            String
  bedNumber             String
  rentAmount            Float
  securityDeposit       Float
  maintenanceCharges    Float              @default(500)
  electricityCharges    String             @default("As per Sub-Meter Reading")
  wifiCharges           String             @default("Complimentary High-Speed WiFi")
  foodCharges           String             @default("Included in Monthly Rent")
  noticePeriodDays      Int                @default(30)
  refundPolicy          String             @default("Security deposit refundable within 7 days post checkout deduction.")
  houseRules            String[]
  visitorPolicy         String             @default("Visitors allowed in common areas till 8 PM.")
  curfewTime            String             @default("10:30 PM Gate Locking Time")
  damagePolicy          String             @default("Resident liable for physical property damage repairs.")
  prohibitedActivities  String[] // Smoking, Alcohol, Illegal Substances, Noise
  cleanlinessTerms      String             @default("Daily housekeeping provided. Resident must maintain room hygiene.")
  terminationClause     String             @default("Agreement terminable by either party with 30-day prior written notice.")
  privacyClause         String             @default("Resident data protected under IT Act & DPDP Act 2023.")
  disputeJurisdiction   String             @default("City Courts Jurisdiction")
  witnessName           String?
  witnessPhone          String?
  startDate             DateTime
  endDate               DateTime
  status                AgreementStatus    @default(PENDING)
  contractPdfUrl        String?
  qrVerificationPayload String?
  signatures            Signature[]
  versions              AgreementVersion[]
  verifications         Verification[]
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([residentId])
  @@index([ownerId])
  @@index([pgId])
  @@index([status])
}

model AgreementVersion {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  agreementId   String    @db.ObjectId
  agreement     Agreement @relation(fields: [agreementId], references: [id])
  versionNumber Int
  contractHtml  String
  changeReason  String?
  createdAt     DateTime  @default(now())
}

model Signature {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  agreementId      String    @db.ObjectId
  agreement        Agreement @relation(fields: [agreementId], references: [id])
  signerType       String // RESIDENT, OWNER, WITNESS
  signerName       String
  signatureDataSvg String
  ipAddress        String
  timestamp        DateTime  @default(now())
  hashHmac         String
}

model Verification {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  agreementId      String    @db.ObjectId
  agreement        Agreement @relation(fields: [agreementId], references: [id])
  verificationCode String    @unique
  verifiedAt       DateTime  @default(now())
  ipAddress        String
}

// ==========================================
// LEAVE & HOLD APPLICATIONS
// ==========================================

model LeaveApplication {
  id             String      @id @default(auto()) @map("_id") @db.ObjectId
  residentId     String      @db.ObjectId
  resident       Resident    @relation(fields: [residentId], references: [id])
  pgId           String      @db.ObjectId
  pg             PG          @relation(fields: [pgId], references: [id])

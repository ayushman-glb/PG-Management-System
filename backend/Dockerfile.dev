FROM node:20-alpine

WORKDIR /app

# Install native compilation toolchain, openssl, and curl for healthchecks
RUN apk add --no-cache python3 make g++ curl openssl

# Install dependencies and generate Prisma Client for Linux container runtime
COPY package*.json ./
COPY prisma ./prisma/

RUN npm install
RUN npx prisma generate

# Copy source tree
COPY . .

EXPOSE 5000

CMD ["npm", "run", "dev"]

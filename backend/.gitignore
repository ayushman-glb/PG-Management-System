# ============================================================
# RoomBae Backend — .gitignore
# ============================================================

# ── Dependencies ─────────────────────────────────────────────
node_modules/

# ── Build Outputs ─────────────────────────────────────────────
dist/
tsc_out.txt
coverage/

# ── Environment / Secrets ─────────────────────────────────────
.env
.env.local
.env.development
.env.production
.env.staging
.env.test
.env.*.local
!.env.example

# Private keys, certificates, service accounts
*.pem
*.key
*.crt
*.p12
*.pfx
serviceAccountKey*.json
service-account*.json
firebase-admin*.json

# Uploads / temp
temp_uploads/
uploads/

# ── Logs ────────────────────────────────────────────────────
logs/
*.log

# ── OS files ─────────────────────────────────────────────────
.DS_Store
Thumbs.db

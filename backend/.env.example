# -----------------------------------------------------------------------------
# RoomBae Environment Configuration Template (.env.example)
# Copy this file to .env.development or .env.production and fill in values.
# DO NOT COMMIT REAL SECRETS TO REPOSITORY!
# -----------------------------------------------------------------------------

NODE_ENV=development
PORT=5000

# Application URLs
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:5000
API_PREFIX=/api/v1

# Database & Cache Connection
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
REDIS_URL=redis://localhost:6379

# Cryptography & Token Secrets
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Generate a DIFFERENT value for each key — never reuse JWT_SECRET for JWT_REFRESH_SECRET
JWT_SECRET=your_64_byte_hex_secret_here_generate_with_crypto_randomBytes_64
JWT_REFRESH_SECRET=your_different_64_byte_hex_refresh_secret_here
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
SESSION_SECRET=your_express_session_secret_min_32_chars
AES_256_KEY=your_64_char_hex_aes_key_here_0000000000000000000000000000000000
ENCRYPTION_KEY=your_64_char_hex_encryption_key_here_000000000000000000000000
KYC_ENCRYPTION_KEY=your_64_char_hex_kyc_key_here_000000000000000000000000000

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Brevo SMTP Mailer Configuration
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_smtp_user
SMTP_PASS=your_brevo_smtp_password
EMAIL_FROM="RoomBae Enterprise <noreply@roombae.com>"

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Firebase Admin SDK Configuration
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Payment Gateway Configuration (Razorpay)
RAZORPAY_KEY_ID=rzp_test_mock_key
RAZORPAY_KEY_SECRET=mock_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=mock_webhook_secret

# Upload Limits & Configuration
UPLOAD_MAX_SIZE=10485760
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
ALLOWED_DOCUMENT_TYPES=application/pdf

# Server Cluster Mode
CLUSTER_MODE=false

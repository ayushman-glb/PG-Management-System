# -----------------------------------------------------------------------------
# ROOMBAE ENTERPRISE BACKEND ENVIRONMENT CONFIGURATION (.env.example)
# -----------------------------------------------------------------------------

# 1. SERVER & RUNTIME
PORT=5000
NODE_ENV=production
CLIENT_URL="https://ayushman-glb.github.io"
FRONTEND_URL="https://ayushman-glb.github.io/PG-Management-System/"
API_BASE_URL="https://pg-management-system-boxb.onrender.com"
API_PREFIX=/api/v1

# 2. DATABASE & ORM (MongoDB 7.0 Replica Set or MongoDB Atlas)
# Local: mongodb://username:password@host:port/database_name?replicaSet=rs0
# Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database_name>?retryWrites=true&w=majority&appName=<appName>
DATABASE_URL="mongodb+srv://username:password@cluster.mongodb.net/roombae_db?retryWrites=true&w=majority"
MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/roombae_db?retryWrites=true&w=majority"

# 3. SECURITY & CRYPTOGRAPHY
JWT_SECRET="replace_with_32_char_random_secret"
JWT_REFRESH_SECRET="replace_with_32_char_random_refresh_secret"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"
SESSION_SECRET="replace_with_32_char_random_session_secret"
AES_256_KEY="replace_with_64_hex_chars_for_32_byte_key"
KYC_ENCRYPTION_KEY="replace_with_64_hex_chars_for_32_byte_key"

# 4. PAYMENT GATEWAY (Razorpay)
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# 5. AUTHENTICATION (Google OAuth 2.0)
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_CALLBACK_URL="https://your-backend-domain.onrender.com/api/v1/auth/google/callback"

# 6. EMAIL & SMS GATEWAY
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_gmail_app_password"
EMAIL_FROM="RoomBae Security <noreply@roombae.com>"
SMS_API_KEY="your_sms_gateway_api_key_or_mock"

# 7. GEOLOCATION & MAPS
NOMINATIM_USER_AGENT="RoomBae-PG-Management/1.0"

# 8. REDIS (optional for production if you use it)
REDIS_URL="redis://127.0.0.1:6379"

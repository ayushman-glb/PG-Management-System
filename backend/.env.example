# ==============================================================================
# RoomBae Enterprise SaaS Backend — Environment Variables Template (.env.example)
# ==============================================================================
# Copy this file to .env.development or .env.production and populate values.

# ── Server & Environment ──────────────────────────────────────────────────────
# Port on which Express server listens (default: 5000)
PORT=5000
# Node environment: 'development', 'production', or 'test'
NODE_ENV=production
# Public URL of the frontend application (for CORS & redirect origins)
CLIENT_URL=https://pg-management-system.vercel.app
FRONTEND_URL=https://pg-management-system.vercel.app
# Comma-separated list of additional allowed CORS origins (Vercel project previews are matched automatically)
CORS_ORIGINS=https://pg-management-system.vercel.app,https://ayushman-glb.github.io
# Explicit cross-origin deployment toggle (defaults to true; set to false only for local same-origin dev)
CROSS_ORIGIN_DEPLOYMENT=true
# Temporary diagnostic auth debugging flag (set to true to enable high-verbosity auth logs, remove/unset after diagnosis)
DEBUG_AUTH=false
# NOTE ON COOKIE_DOMAIN: Leave COOKIE_DOMAIN unset for cross-origin Vercel <-> Render deployments.
# Base public URL of this Express API server
API_BASE_URL=https://pg-management-system-boxb.onrender.com
# Versioned API path prefix
API_PREFIX=/api/v1

# ── Database & Cache Infrastructure ───────────────────────────────────────────
# MongoDB Atlas Connection String.
# SOURCE: MongoDB Atlas Console -> Database -> Connect -> Drivers (Node.js).
# NOTE: Must include retryWrites=true&w=majority&replicaSet=... for transactions & Prisma ORM support.
DATABASE_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/roombae?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/roombae?retryWrites=true&w=majority
CACHE_TTL=3600
SESSION_TTL=86400

# ── Security & Cryptographic Secrets ──────────────────────────────────────────
# Generate strong 32+ character random hex strings via `openssl rand -hex 32`
JWT_SECRET=your_jwt_access_secret_here_min32chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_min32chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

SESSION_SECRET=your_session_secret_here_min32chars
COOKIE_SECRET=your_cookie_secret_here_min32chars
CSRF_SECRET=your_csrf_secret_here_min32chars

PASSWORD_RESET_SECRET=your_password_reset_secret_here_min32chars
EMAIL_VERIFICATION_SECRET=your_email_verification_secret_here_min32chars
API_KEY_SECRET=your_api_key_secret_here_min32chars

# AES-256-GCM 64-character hex key for sensitive financial data encryption
# SOURCE: Generate via `openssl rand -hex 32`
AES_256_KEY=your_aes256_key_here_64_hex_chars
ENCRYPTION_KEY=your_encryption_key_here_64_hex_chars
KYC_ENCRYPTION_KEY=your_kyc_encryption_key_here_64_hex_chars

# ── Third-Party Integrations ─────────────────────────────────────────────────
# Google Gmail SMTP Setup
# SOURCE: Google Account -> Security -> 2-Step Verification -> App Passwords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your_gmail_address@gmail.com
MAIL_APP_PASSWORD=your_16_digit_app_password
MAIL_FROM_NAME=RoomBae
MAIL_FROM_EMAIL=your_gmail_address@gmail.com
EMAIL_FROM="RoomBae <your_gmail_address@gmail.com>"

# Cloudinary Media Storage Setup
# SOURCE: Cloudinary Dashboard -> Product Environment Credentials
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Google OAuth 2.0 Credentials
# SOURCE: Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://pg-management-system-boxb.onrender.com/api/v1/auth/google/callback

# Razorpay Payment Gateway Credentials
# SOURCE: Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
